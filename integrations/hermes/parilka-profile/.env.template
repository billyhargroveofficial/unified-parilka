# Parilka Hermes profile: non-secret local runtime settings.
# OAuth for the sole model provider is stored by Hermes, not here:
#   hermes -p parilka auth add openai-codex

# The only Telegram group this profile may serve.
PARILKA_TELEGRAM_CHAT_ID=-1003179772905

# Loopback-only Parilka MCP bridge used by the five cache-read plugin tools.
PARILKA_MCP_HTTP_URL=http://127.0.0.1:8766/mcp

# Optional comma-separated Telegram sender IDs allowed to write ordinary
# memory or skills. Leave empty to keep model-initiated writes blocked.
PARILKA_BOT_MEMORY_WRITE_SENDER_IDS=

# Codex-native web search uses Hermes OAuth. Lightpanda's binary and local
# timeouts are declared in config.yaml; no API keys, SearXNG or Firecrawl
# endpoints are used by this profile.
