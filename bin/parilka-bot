#!/usr/bin/env bash
set -euo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_dir="${TELEGRAM_PROJECT_DIR:-$(cd -- "$script_dir/.." && pwd)}"
cd "$project_dir"

entrypoint="$project_dir/dist/bot-daemon.js"
"$project_dir/bin/telegram-parilka-mcp-check-build" "$project_dir" "$entrypoint"

# shellcheck source=bin/parilka-secret-env
source "$project_dir/bin/parilka-secret-env"
parilka_load_secret_file PARILKA_BOT_TOKEN PARILKA_BOT_TOKEN_FILE
parilka_load_secret_file PARILKA_QWEN_API_KEY PARILKA_QWEN_API_KEY_FILE
parilka_load_secret_file PARILKA_DEEPSEEK_API_KEY PARILKA_DEEPSEEK_API_KEY_FILE

node_bin="${TELEGRAM_NODE:-node}"
exec "$node_bin" "$entrypoint" "$@"
