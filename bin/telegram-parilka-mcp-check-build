#!/usr/bin/env bash
set -euo pipefail

project_dir="${1:?project directory is required}"
entrypoint="${2:?built entrypoint is required}"

if [[ ! -f "$entrypoint" ]]; then
  printf 'telegram-parilka-mcp: missing built entrypoint: %s\n' "$entrypoint" >&2
  printf 'Run: cd %q && npm run build\n' "$project_dir" >&2
  exit 78
fi

responses_current="$project_dir/.deploy/responses-current"
if [[ -L "$responses_current" ]]; then
  responses_release="$(realpath -e -- "$responses_current" 2>/dev/null || true)"
  resolved_entrypoint="$(realpath -e -- "$entrypoint" 2>/dev/null || true)"
  if [[ -n "$responses_release" && "$resolved_entrypoint" == "$responses_release/"* ]]; then
    if ! "${TELEGRAM_NODE:-node}" "$project_dir/scripts/responses-release-provenance.mjs" \
      --release "$responses_release"
    then
      printf 'telegram-parilka-mcp: active Responses release provenance is stale or unsafe\n' >&2
      printf 'Run: cd %q && npm run build:responses-release\n' "$project_dir" >&2
      exit 78
    fi
    exit 0
  fi
fi

stale_source="$(
  find "$project_dir/src" -type f -name '*.ts' \
    -newer "$entrypoint" -print -quit
)"

if [[ -z "$stale_source" ]]; then
  for source_config in \
    "$project_dir/package.json" \
    "$project_dir/package-lock.json" \
    "$project_dir/tsconfig.json"
  do
    if [[ -f "$source_config" && "$source_config" -nt "$entrypoint" ]]; then
      stale_source="$source_config"
      break
    fi
  done
fi

if [[ -n "$stale_source" ]]; then
  printf 'telegram-parilka-mcp: built entrypoint is stale: %s\n' "$entrypoint" >&2
  printf 'Newer source/config file: %s\n' "$stale_source" >&2
  printf 'Run: cd %q && npm run build\n' "$project_dir" >&2
  exit 78
fi
