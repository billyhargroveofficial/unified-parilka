#!/usr/bin/env bash
set -euo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_dir="${TELEGRAM_PROJECT_DIR:-$(cd -- "$script_dir/.." && pwd)}"
cd "$project_dir"

entrypoint="$project_dir/dist/hermes-projection-cli.js"
"$project_dir/bin/telegram-parilka-mcp-check-build" "$project_dir" "$entrypoint"

# shellcheck source=bin/parilka-secret-env
source "$project_dir/bin/parilka-secret-env"

node_bin="${TELEGRAM_NODE:-node}"
state_db="${PARILKA_DIGEST_DB_PATH:-${PARILKA_BOT_DB_PATH:-${TELEGRAM_DB_PATH:-$HOME/.telegram-parilka-mcp/messages.sqlite}}}"
chat_id="${PARILKA_DIGEST_CHAT_ID:-${PARILKA_BOT_CHAT_ID:-}}"
has_db=0
has_chat=0
has_home=0
for argument in "$@"; do
  if [[ "$argument" == "--db" ]]; then
    has_db=1
  elif [[ "$argument" == "--chat" ]]; then
    has_chat=1
  elif [[ "$argument" == "--hermes-home" ]]; then
    has_home=1
  fi
done

args=()
if (( ! has_db )) && [[ -n "$state_db" ]]; then
  args+=(--db "$state_db")
fi
if (( ! has_chat )) && [[ -n "$chat_id" ]]; then
  args+=(--chat "$chat_id")
fi
if (( ! has_home )); then
  args+=(--hermes-home "$HOME/.hermes/profiles/parilka")
fi

exec "$node_bin" "$entrypoint" "${args[@]}" "$@"
