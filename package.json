{
  "name": "parilka",
  "version": "0.2.0",
  "description": "Unified Telegram chat bot, MTProto sync service, and MCP server for Parilka.",
  "type": "module",
  "private": true,
  "bin": {
    "parilka-bot": "./dist/bot-daemon.js",
    "parilka-digests": "./bin/parilka-digests",
    "parilka-hermes-project": "./bin/parilka-hermes-project",
    "parilka-openclaw-project": "./bin/parilka-openclaw-project",
    "parilka-maintain": "./bin/parilka-maintain",
    "telegram-parilka-mcp": "./dist/index.js",
    "telegram-parilka-mcp-generate-session": "./dist/generate-session.js",
    "telegram-parilka-mcp-sync-daemon": "./dist/sync-daemon.js",
    "telegram-parilka-mcp-embed-index": "./dist/embed-index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:shell": "bash -n bin/parilka-bge-m3 bin/parilka-bot bin/parilka-digests bin/parilka-hermes-project bin/parilka-openclaw-project bin/parilka-import-python-state bin/parilka-maintain bin/parilka-secret-env bin/telegram-parilka-mcp bin/telegram-parilka-mcp-check-build bin/telegram-parilka-mcp-sync-daemon bin/telegram-parilka-mcp-embed-index bin/telegram-parilka-mcp-generate-session",
    "check:systemd": "systemd-analyze --user verify systemd/parilka-*.service systemd/parilka-*.timer",
    "test": "node --test --import tsx tests/*.test.ts",
    "test:service-contract": "python3 -m unittest discover -s services/bge-m3 -p 'test_*.py' -v",
    "test:hermes": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'hermes_plugin_*.py' -v && node --test --import tsx tests/hermes-tool-schemas.test.ts",
    "test:openclaw": "node --test --import tsx tests/openclaw-*.test.ts tests/config-openclaw-projection.test.ts",
    "test:coverage": "node --experimental-test-coverage --test --import tsx tests/*.test.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:mcp:direct": "tsx scripts/smoke-mcp.ts --direct",
    "smoke:mcp:wrapper": "tsx scripts/smoke-mcp.ts --wrapper",
    "smoke:mtcute-storage": "tsx scripts/smoke-mtcute-storage.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run check && npm run check:shell && npm run check:architecture && npm run check:systemd && npm run build && npm test && npm run test:service-contract && npm run benchmark:retrieval && npm run secret-scan && npm run smoke:mtcute-storage && npm run smoke:mcp && npm run smoke:mcp:wrapper && npm run smoke:mcp:direct && npm run audit",
    "bot": "tsx src/bot-daemon.ts",
    "bot:start": "node dist/bot-daemon.js",
    "dev": "tsx src/index.ts",
    "generate-session": "tsx src/generate-session.ts",
    "embed-once": "tsx src/embed-index.ts",
    "digests": "node dist/digest-cli.js",
    "import:python-state": "node dist/python-import-cli.js",
    "maintain": "node dist/maintenance-cli.js",
    "print-config": "tsx src/index.ts --print-config",
    "validate-config": "tsx src/index.ts --validate-config",
    "status": "tsx src/index.ts --status",
    "sync-once": "tsx src/sync-daemon.ts --once",
    "sync-daemon": "tsx src/sync-daemon.ts",
    "benchmark:vector": "tsx scripts/benchmark-vector-search.ts",
    "benchmark:retrieval": "tsx scripts/benchmark-retrieval-eval.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.24",
    "@ai-sdk/deepseek": "^3.0.16",
    "@ai-sdk/openai": "^4.0.24",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mtcute/convert": "^0.31.0",
    "@mtcute/node": "^0.31.0",
    "ai": "^7.0.42",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "input": "^1.0.1",
    "pino": "^10.3.1",
    "telegram": "^2.26.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
