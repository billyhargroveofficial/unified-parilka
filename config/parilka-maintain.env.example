# Private environment slice for systemd/parilka-maintain.service.
#
# Install a reviewed copy as ~/.config/parilka/parilka-maintain-codex.env with mode
# 0600. It serves only bounded SQLite maintenance plus digest/Dream. Do not put
# Bot API tokens, MTProto API/session secrets, Telegram MCP write settings or
# real credentials in it.

# The canonical shared database and exactly one allowed chat. Keep these in
# sync with the poller/sync configuration; the digest CLI rejects a mismatched
# configured database identity.
TELEGRAM_DB_PATH=/absolute/path/to/messages.sqlite
PARILKA_DIGEST_DB_PATH=/absolute/path/to/messages.sqlite
TELEGRAM_ALLOWED_CHAT_IDS=-1000000000000
PARILKA_DIGEST_CHAT_ID=-1000000000000
PARILKA_BOT_ID=100000000

# Persistent curated chat memory and bounded digest/Dream generation.
PARILKA_MEMORY_MAX_CHARS=2000
PARILKA_DIGEST_MAX_DAY_GENERATIONS_PER_RUN=3
PARILKA_DIGEST_MAX_WEEK_GENERATIONS_PER_RUN=1
PARILKA_DIGEST_MAX_INPUT_CHARS=160000
PARILKA_DIGEST_MAX_OUTPUT_CHARS=24000
PARILKA_DIGEST_ITEM_TIMEOUT_MS=150000
PARILKA_DIGEST_MODEL_TOTAL_TIMEOUT_MS=300000
PARILKA_DIGEST_MODEL_CANDIDATE_TIMEOUT_MS=120000

# Direct Codex subscription model, Fast wire tier (`priority`) and reasoning
# policy are hard-pinned in code. The unit injects the shared owner-only OAuth
# state path at its final exec seam. Intentionally absent and unit-owned:
# PARILKA_DIGEST_CODEX_AUTH_FILE
