# Private environment slice for systemd/parilka-bot.service.
#
# Install a reviewed copy as ~/.config/parilka/parilka-bot-codex.env with mode 0600.
# This file belongs only to the native Bot API poller. It must not contain
# MTProto API/session values, Telegram MCP send settings, model-router values,
# or any real secret committed to Git.
#
# Keep PARILKA_BOT_MODE=shadow and PARILKA_BOT_EXCLUSIVE_POLLER empty while the
# previous poller owns the token. Set MODE=live and EXCLUSIVE_POLLER=true only
# in the controlled cutover immediately after that owner is inactive; shadow
# mode still consumes getUpdates and therefore cannot safely run in parallel.

# Use an owner-owned 0400/0600 one-line token file. Do not add the token itself
# to this template or a checked-in file.
PARILKA_BOT_TOKEN_FILE=/absolute/path/to/parilka-bot-token
PARILKA_BOT_EXCLUSIVE_POLLER=
PARILKA_BOT_MODE=shadow

# One bot, one allowed chat, one canonical shared SQLite path.
PARILKA_BOT_CHAT_ID=-1000000000000
PARILKA_BOT_DB_PATH=/absolute/path/to/messages.sqlite
# This optional alias is checked for identity by the bot; retain the same path.
TELEGRAM_DB_PATH=/absolute/path/to/messages.sqlite
PARILKA_BOT_ID=100000000
PARILKA_BOT_USERNAME=ExampleParilkaBot

# The launcher, not this file, enforces one durable worker.
PARILKA_BOT_WORKERS=1
PARILKA_BOT_TRIGGER_COOLDOWN_MS=5000
PARILKA_BOT_UPDATE_MAX_ATTEMPTS=3
# PARILKA_BOT_INITIAL_OFFSET=0
PARILKA_BOT_POLL_TIMEOUT_SEC=30
PARILKA_BOT_POLL_LIMIT=100
PARILKA_BOT_POLL_BACKOFF_INITIAL_MS=1000
PARILKA_BOT_POLL_BACKOFF_MAX_MS=30000
PARILKA_BOT_PUBLISH_TIMEOUT_MS=30000
PARILKA_BOT_SHUTDOWN_TIMEOUT_MS=660000

# Direct Codex subscription policy. The adapter hard-pins Luna/Fast (wire
# service tier: priority) and its reasoning level in code; only the turn
# timeout remains configurable. Never put OAuth material in this file: systemd
# injects the one shared owner-only state path at the final exec seam.
PARILKA_BOT_RESPONSES_TURN_TIMEOUT_MS=180000

# Read-only chat retrieval stays on the host-owned loopback BGE-M3 service.
# It is optional to spell these defaults out, but any override must remain a
# root loopback origin; model/provider routing is intentionally not configurable.
PARILKA_BOT_RAG_LOCAL_ENDPOINT=http://127.0.0.1:8767
PARILKA_BOT_RAG_LOCAL_REQUEST_TIMEOUT_MS=2000
PARILKA_BOT_RAG_RERANK_TIMEOUT_MS=2000
PARILKA_BOT_RAG_RERANK_MAX_CANDIDATES=8
PARILKA_BOT_RAG_AUTOMATIC_TIMEOUT_MS=2500

# Leave blank to fail closed. Put real numeric sender IDs only in the private
# installed copy, never in Git or a model configuration.
PARILKA_BOT_MEMORY_WRITE_SENDER_IDS=

# Intentionally absent and forcibly owned by the unit's final exec seam:
# PARILKA_BOT_LOCK_FILE
# PARILKA_BOT_CODEX_AUTH_FILE
