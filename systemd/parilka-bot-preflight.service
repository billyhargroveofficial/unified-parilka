[Unit]
Description=Validate Parilka direct Codex subscription Responses configuration without Bot API ownership
Documentation=file:%h/repos/parilka-unified/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/repos/parilka-unified
# This service deliberately has no conflict with the current Bot API owner: the
# preflight parser ignores token/poller fields and never opens Telegram or DB.
EnvironmentFile=%h/.config/parilka/parilka-bot-codex.env
ExecStartPre=%h/repos/parilka-unified/bin/telegram-parilka-mcp-check-build %h/repos/parilka-unified %h/repos/parilka-unified/.deploy/responses-current/bot-daemon.js
ExecStart=/usr/bin/env NODE_ENV=production TELEGRAM_PROJECT_DIR=%h/repos/parilka-unified PARILKA_BOT_ENTRYPOINT=%h/repos/parilka-unified/.deploy/responses-current/bot-daemon.js PARILKA_BOT_CODEX_AUTH_FILE=%h/.telegram-parilka-mcp/codex-subscription/auth.json %h/repos/parilka-unified/bin/parilka-bot --preflight
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.telegram-parilka-mcp
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parilka-bot-preflight
